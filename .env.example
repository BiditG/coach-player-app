# Copy to .env.local and fill in your own values. Never commit real credentials.
# NOTE: the values previously committed here were LIVE keys and have been removed.
# If you pulled this file before it was sanitized, rotate both Supabase keys now:
# Supabase dashboard -> Project Settings -> API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to expose to the browser. RLS still applies. Rotate with the service key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER expose this to the browser. Bypasses RLS entirely - server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

NEXT_PUBLIC_MAX_VIDEO_SIZE_MB=500
NEXT_PUBLIC_APP_URL=http://localhost:3000
